{
  "name": "dsh-themes",
  "version": "0.1.9",
  "private": true,
  "description": "Appearance & themes plugin for DSH (DeepSeek Harness): built-in palettes, light/dark/system mode, and VS Code theme import.",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "devDependencies": {
    "fflate": "^0.8.3",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "^6.4.3"
  },
  "scripts": {
    "build": "vp pack",
    "deploy": "vp pack && mkdir -p ~/.dsh/dsh-themes/dist && cp dist/client/index.cjs ~/.dsh/dsh-themes/dist/client.cjs && cp dist/host/index.cjs ~/.dsh/dsh-themes/dist/host.cjs",
    "check": "node --check client/src/*.ts && node --check host/src/*.ts"
  },
  "main": "dist/dsthe-client.js",
  "type": "module",
  "engines": {
    "node": ">=22.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-client-connection": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.5-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  }
}
